   // 贴子样式
   body,
   html {
     width: 100%;
     height: 100%;
     display: table;
     text-align: center;
   }

   body {
     background: #fde3a7;
   }

   ul {
     display: table-cell;
     vertical-align: middle;
   }

   .list-inline {
     padding-left: 0;
     list-style: none;

     > li {
       display: inline-block;
       margin-left: 2em;
     }

     > li:first-child {
       margin-left: 0;
     }
   }

   .thread {

     border-top-right-radius: 5px;
     border-bottom-right-radius: 5px;
     cursor: pointer;
     display: block;
     width: 150px;
     height: 220px;
     position: relative;
     background: lighten(#fde3a7, 20%);
     z-index: 1;
     box-shadow: 0 2px 4px 0 rgba(#000, .1), 0 2px 5px 0 rgba(#000, .25);
     overflow: hidden;
     transition: box-shadow .3s linear;
   }

   .thread img {
     border-top-right-radius: 5px;
     border-bottom-right-radius: 5px;
     width: inherit;
     height: inherit;
     transform-origin: 0 50%;
     transform: rotateY(0);
     transition: all .45s ease;
   }

   .thread:hover {
     box-shadow: 0 2px 4px 0 rgba(#0000009d, .25), 0 2px 5px 0 rgba(#00000098, .45);

     img {
       transform: rotateY(-25deg);
       box-shadow: 1px 1px 5px 5px rgba(#626161a1, .2);
     }
   }

   .thread::after,
   .thread::before {

     border-top-right-radius: 5px;
     border-bottom-right-radius: 5px;
     content: '';
     display: block;
     width: inherit;
     height: inherit;
     position: absolute;
     z-index: -1;
     top: 0;
     background: lighten(#fde3a7, 20%);
     border: 1px solid lighten(#000, 85%);
   }

   .thread::before {
     left: -3px;
   }

   .thread::after {
     left: -6px;
   }
