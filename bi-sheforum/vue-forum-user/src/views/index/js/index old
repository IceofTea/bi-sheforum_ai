   /* 固定顶部导航 */
   .fixednav {
     position: fixed;
     top: 0;
     left: 0;
     right: 0;
     z-index: 10;
     background-color: rgba(0, 0, 0, 0.7);
     backdrop-filter: blur(10px);
     transition: top 0.3s;
   }

   .shownav {
     top: 0;
   }

   .noshownav {
     top: -60px;
   }

